+// Nearby never receives a pairing record, file path, backup or raw engine JSON.
+- (BOOL)canAcceptNearby {
+    return !self.busy && !self.connection.isPairing && !self.connection.isImporting && self.connection.hasPairing &&
+        !self.needsRecovery && [NSBundle.mainBundle pathForResource:@"assets" ofType:@"zip"] != nil;
+}
+- (NSDictionary *)nearbyResult:(NSDictionary *)result code:(int32_t)code {
+    NSUInteger count = [result[@"sims"] isKindOfClass:NSArray.class] ? [result[@"sims"] count] :
+        ([self.snapshot[@"sims"] isKindOfClass:NSArray.class] ? [self.snapshot[@"sims"] count] : 0);
+    return @{@"ok":@(code == 0 && ![result[@"needs_recovery"] boolValue] && ![result[@"rolled_back"] boolValue]),
+             @"catalog":@([result[@"catalog_verified"] boolValue]),
+             @"confirmed":@([result[@"commcenter_verified"] boolValue]),
+             @"recovery":@([result[@"needs_recovery"] boolValue]), @"sims":@(MIN(8, count))};
+}
+- (void)showNearby {
+    if (self.busy || self.connection.isPairing || self.connection.isImporting || self.presentedViewController) return;
+    CSNearbyViewController *nearby = [[CSNearbyViewController alloc] initWithStyle:UITableViewStyleInsetGrouped];
+    __weak typeof(self) weakSelf = self;
+    nearby.canReceive = ^BOOL { return [weakSelf canAcceptNearby]; };
+    nearby.executeRequest = ^(NSDictionary *request, BOOL (^stillAuthorized)(void), void (^reply)(NSDictionary *)) {
+        CSMainViewController *owner = weakSelf;
+        if (!owner || ![owner canAcceptNearby] || !stillAuthorized()) { reply(@{@"ok":@NO}); return; }
+        NSString *action = request[@"action"];
+        owner.bundleName = request[@"bundle"];
+        owner.SIMSelection = [request[@"sim"] integerValue];
+        owner.connectionChecked = NO; owner.snapshot = nil;
+        // Fresh read-only preflight for every owner-approved request. There is no
+        // automatic retry, and consent is checked again before a new write starts.
+        owner.nearbyCompletion = ^(int32_t code, NSDictionary *result) {
+            CSMainViewController *controller = weakSelf;
+            if (!controller) { reply(@{@"ok":@NO}); return; }
+            if ([action isEqualToString:@"status"]) { reply([controller nearbyResult:result code:code]); return; }
+            if (code != 0 || ![controller canAcceptNearby] || !stillAuthorized() ||
+                ([action isEqualToString:@"apply"] && ![result[@"can_apply"] boolValue])) {
+                reply([controller nearbyResult:result code:1]); return;
+            }
+            controller.nearbyCompletion = ^(int32_t finalCode, NSDictionary *finalResult) {
+                CSMainViewController *finisher = weakSelf;
+                reply(finisher ? [finisher nearbyResult:finalResult code:finalCode] : @{@"ok":@NO});
+            };
+            [controller runAction:action];
+        };
+        [owner runAction:@"status"];
+    };
+    UINavigationController *navigation = [[UINavigationController alloc] initWithRootViewController:nearby];
+    navigation.modalInPresentation = YES; // Closing explicitly stops advertising/session.
+    [self presentViewController:navigation animated:YES completion:nil];
+}
 @end
